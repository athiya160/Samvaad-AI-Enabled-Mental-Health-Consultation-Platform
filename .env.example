# Samvaad Mental Health Platform — Environment Configuration
# API keys are strictly loaded server-side and never exposed to the frontend/browser.

# ========================================================
# 1. Google Gemini API (Recommended for conversational quality & Kannada/English support)
# Get a free key at: https://aistudio.google.com/
# ========================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ========================================================
# 2. Alternative: OpenAI / OpenAI-Compatible Endpoint
# ========================================================
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ========================================================
# 3. Database & Storage Configuration
# ========================================================
# SQLite database path (defaults to ./server/data/samvaad.db)
DATABASE_PATH=./server/data/samvaad.db

# ========================================================
# 4. Google OAuth 2.0 / OIDC Configuration
# ========================================================
# Create credentials in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5173/api/auth/google/callback (or http://127.0.0.1:5173/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ========================================================
# 5. Server Configuration (for standalone / production backend)
# ========================================================
PORT=5001
NODE_ENV=development
